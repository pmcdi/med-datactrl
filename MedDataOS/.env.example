# Required: Google Gemini API key
GEMINI_API_KEY=your_api_key_here

# Optional. When the key, endpoint, and deployment name are all set, the
# clinical notes agent calls this Azure OpenAI deployment instead of Gemini.
# AZURE_OPENAI_API_VERSION is the date Azure expects, such as 2024-10-21.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Server configuration (optional)
HOST=0.0.0.0
PORT=8080

# External services (optional)
CHEST_XRAY_SERVICE_URL=http://localhost:8000/classify/url
